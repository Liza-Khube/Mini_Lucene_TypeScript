{
  "name": "mini_lucene_typescript",
  "version": "1.0.0",
  "description": "Повнотекстовий пошуковий рушій",
  "main": "app.js",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "start": "tsx src/app.ts",
    "build": "tsc -p tsconfig.build.json",
